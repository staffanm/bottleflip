# bottleflip.tomtebo.org: a static site. Certbot adds the TLS lines and the redirect from port 80.
server {
    listen 80;
    listen [::]:80;
    server_name bottleflip.tomtebo.org;

    # `npm run deploy` copies the Vite build output here.
    root /home/staffan/sites/bottleflip.tomtebo.org;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    # Vite puts a content hash in these file names
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
    add_header X-Content-Type-Options "nosniff" always;
}
